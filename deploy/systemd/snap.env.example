# /etc/subplane/snap-<instance>.env for spwsgw-snap@<instance> (docs/snap.md, "Running").
# Hosts: write them as the other side writes them (by host name on both ends), so
# /topology keys join across boxes (docs/observability.md, "Endpoint keys").

# The gateway's media driver directory (its --aeron-dir; empty there means /dev/shm/aeron-<user>).
SNAP_AERON_DIR=/dev/shm/aeron-subplane
# The gateway's --channel, --stream-id and --state-stream.
SNAP_DATA_CHANNEL=aeron:ipc
SNAP_DATA_STREAM=1001
SNAP_STATE_STREAM=1002
# What the agents' partition recap section names: recap.request.channel, and the
# control= address of recap.response.channel.
SNAP_RECAP_CHANNEL=aeron:udp?endpoint=gw-box1:40500
SNAP_RECAP_RESPONSE=gw-box1:40501
# The gateway's --control-channel and --control-response.
SNAP_GATEWAY_CONTROL=aeron:udp?endpoint=gw-box1:40600
SNAP_GATEWAY_RESPONSE=gw-box1:40601
# At least the largest max_levels of the gateway's pack (Coinbase: 65536).
SNAP_BOOK_LEVELS=5000
SNAP_HTTP=127.0.0.1:9102
# Anything else, e.g. "--site ny4 --env prod --labels team=md --quiet".
SNAP_EXTRA=
